# ===================================================================
# QUADRAABERTA API - EXEMPLO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env ou configure no seu provedor de deploy
# ===================================================================

# --- Banco de Dados PostgreSQL (Local ou Nuvem: Neon / Supabase) ---
# Local Docker:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/quadra_aberta_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgressecret

# Nuvem (Exemplo Neon / Supabase - requer sslmode=require):
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example-12345.us-east-2.aws.neon.tech/quadra_aberta_db?sslmode=require
# SPRING_DATASOURCE_USERNAME=seu_usuario_neon
# SPRING_DATASOURCE_PASSWORD=sua_senha_neon

# --- Segurança & JWT ---
# Chave secreta de pelo menos 256 bits (32 bytes em hexadecimal ou Base64)
JWT_SECRET=9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f123456
JWT_EXPIRATION_HOURS=24

# --- Armazenamento de Fotos de Zeladoria (Cloudinary Free Tier) ---
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# --- CORS (Origens permitidas para frontends Vercel / Localhost) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://quadra-aberta.vercel.app

# --- Porta do Servidor ---
PORT=8080
