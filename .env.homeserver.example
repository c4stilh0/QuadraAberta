# ==============================================================================
# QUADRAABERTA - VARIÁVEIS PARA HOME SERVER (PRODUÇÃO / APRESENTAÇÃO)
# Copie para `.env` na raiz antes de rodar o docker-compose.homeserver.yml:
#   cp .env.homeserver.example .env
# ==============================================================================

# --- Banco de Dados PostgreSQL (obrigatório definir senha forte) ---
POSTGRES_DB=quadra_aberta_db
POSTGRES_USER=quadra_admin
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE_AQUI

# --- Segurança JWT (obrigatório: mínimo 32+ caracteres aleatórios) ---
# Gere com: openssl rand -hex 32
JWT_SECRET=TROQUE_POR_UM_SEGREDO_ALEATORIO_DE_64_HEX_CHARS
JWT_EXPIRATION_HOURS=24

# --- Porta local onde o Nginx do frontend escutará no Home Server ---
# Mantendo 127.0.0.1, apenas o túnel ou proxy reverso local acessa.
# Para acessar direto pela rede local (LAN), altere APP_BIND_IP=0.0.0.0
APP_BIND_IP=127.0.0.1
APP_PORT=8088

# --- URL pública (ex.: domínio configurado no Cloudflare Tunnel) ---
CORS_ALLOWED_ORIGINS=https://quadra.seudominio.com,http://localhost:8088
QUADRAABERTA_BACKEND_URL=

# --- Demo / Documentação ---
# Mantenha false em links públicos para não expor os botões de login com 1 clique
VITE_ENABLE_DEMO_LOGIN=false
# Coloque false para desativar o Swagger em produção pública
SWAGGER_ENABLED=true

# --- Cloudinary (opcional; se não configurar, usa /uploads/ persistido em volume) ---
CLOUDINARY_CLOUD_NAME=demo-quadraaberta
CLOUDINARY_API_KEY=demo-key
CLOUDINARY_API_SECRET=demo-secret

# --- Cloudflare Tunnel (usado apenas se subir com `--profile tunnel`) ---
CLOUDFLARE_TUNNEL_TOKEN=
